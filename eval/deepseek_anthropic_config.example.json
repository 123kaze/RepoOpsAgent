{
  "agents": {
    "defaults": {
      "workspace": "/absolute/path/to/nanobot-snapshot",
      "model": "deepseek-v4-pro",
      "provider": "anthropic",
      "maxTokens": 4096,
      "maxToolIterations": 10,
      "temperature": 0.1,
      "failOnToolError": false
    }
  },
  "providers": {
    "anthropic": {
      "apiKey": "${REPOOPS_DEEPSEEK_AUTH_TOKEN}",
      "apiBase": "https://api.deepseek.com/anthropic",
      "extraHeaders": {
        "Authorization": "Bearer ${REPOOPS_DEEPSEEK_AUTH_TOKEN}"
      }
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "web": {
      "enable": false
    },
    "exec": {
      "enable": false
    },
    "file": {
      "enable": false
    },
    "cliApps": {
      "enable": false
    },
    "my": {
      "enable": false
    },
    "repoops": {
      "enable": true,
      "allowedRepositories": ["HKUDS/nanobot"],
      "token": "${REPOOPS_GITHUB_TOKEN}",
      "maxOutputChars": 16000,
      "statusBarEnabled": true,
      "statusBarToolBudget": 10,
      "statusBarRepeatLimit": 3,
      "statusBarNoProgressLimit": 3
    }
  }
}
